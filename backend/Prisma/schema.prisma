// ==========================================
// FILE: prisma/schema.prisma
// ==========================================

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum SessionStatus {
  ACTIVE
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum NegotiatorPersona {
  AGGRESSIVE
  BALANCED
  FLEXIBLE
}

enum SenderType {
  BUYER
  SELLER
  AI
}

enum ActionType {
  ACCEPT
  REJECT
  COUNTER
}

model User {
  id                   String                 @id @default(auto()) @map("_id") @db.ObjectId
  email                String                 @unique
  password             String
  name                 String
  phone                String?
  isVerified           Boolean                @default(false)
  items                Item[]
  createdAt            DateTime               @default(now())
  AiNegotiationSession AiNegotiationSession[]
  UserAiMemory         UserAiMemory[]
  UserMemory           UserMemory[]
  AiAuditLog           AiAuditLog[]
}

model Item {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  stockName   String
  price       Float
  currency    String   @default("NGN")
  description String
  category    String   @default("Uncategorized")

  country     String   @default("Nigeria")
  city        String   @default("")
  area        String   @default("")

  whatsapp    String?
  facebook    String?
  tiktok      String?
  instagram   String?

  canBargain  Boolean  @default(true)
  images      String[]

  userId      String   @db.ObjectId
  seller      User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())

  aiConfig              ProductAiConfig?
  aiNegotiationSessions AiNegotiationSession[]

  @@index([stockName])
  @@index([category])
  @@index([userId])
}

model ProductAiConfig {
  id                   String   @id @default(auto()) @map("_id") @db.ObjectId
  itemId               String   @unique @db.ObjectId
  item                 Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  autoNegotiateEnabled Boolean  @default(true)
  minimumPrice         Float
  targetPrice          Float
  walkawayPrice        Float
  discountStepPercent  Float    @default(5.0)
  maxDiscountRounds    Int      @default(3)

  bulkMinQuantity      Int?
  bulkDiscountPercent  Float?

  acceptsTradeIn       Boolean  @default(false)
  tradeInTerms         String?

  bundledItems         String?
  bundleDiscount       Float?

  acceptedPayments     String[] @default(["cash", "transfer"])
  cashDiscountPercent  Float?

  freeDeliveryEligible Boolean  @default(false)
  deliveryFeeEstimate  Float?
  pickupAddress        String?
  dispatchTimeline     String?

  stockCount           Int      @default(1)
  urgencyLevel         String   @default("normal")
  expirationDate       DateTime?

  warrantyPeriod       String?
  returnPolicyDays     Int?     @default(0)

  productCondition     String   @default("Brand New")
  knownFlaws           String?

  specifications       String?
  faqKnowledgeBase     String?

  minBuyerRating       Float?

  aiTone               String   @default("Professional and Friendly")
  greetingMessage      String?

  escalateOnThreshold  Float?
  sellerContactPhone   String?

  totalNegotiations    Int      @default(0)
  successfulDeals      Int      @default(0)

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model AiNegotiationSession {
  id           String          @id @default(auto()) @map("_id") @db.ObjectId
  itemId       String?         @db.ObjectId
  item         Item?           @relation(fields: [itemId], references: [id], onDelete: Cascade)

  buyerId      String?         @db.ObjectId
  buyer        User?           @relation(fields: [buyerId], references: [id])
  buyerSession String

  currentOffer Float?
  agreedPrice  Float?
  status       String          @default("active")
  roundCount   Int             @default(0)

  messages     AiChatMessage[]

  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([itemId])
  @@index([buyerSession])
}

model AiChatMessage {
  id        String               @id @default(auto()) @map("_id") @db.ObjectId
  sessionId String               @db.ObjectId
  session   AiNegotiationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  sender    String
  message   String
  offerMade Float?

  createdAt DateTime             @default(now())
}

model UserMemory {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  category  String   // e.g., "preference", "budget", "project", "habit"
  key       String
  value     String
  weight    Float    @default(1.0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ConversationContext {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  conversationId String   @unique @db.ObjectId
  summary        String?
  extractedFacts String[]
  lastActive     DateTime @default(now())
}

model UserAiMemory {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  value     String
  category  String   @default("preference")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
  @@index([userId])
}

model AiAuditLog {
  id                   String   @id @default(auto()) @map("_id") @db.ObjectId
  userId               String?  @db.ObjectId
  user                 User?    @relation(fields: [userId], references: [id])
  requestId            String   @unique
  provider             String
  model                String
  promptTokens         Int      @default(0)
  completionTokens     Int      @default(0)
  toolsExecuted        String[]
  requiresConfirmation Boolean  @default(false)
  confirmationGranted  Boolean?
  securityFlag         Boolean  @default(false)
  latencyMs            Int
  createdAt            DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model NegotiationSession {
  id           String            @id @map("_id")
  productId    String
  productName  String
  listPrice    Float
  floorPrice   Float
  currentPrice Float
  status       SessionStatus     @default(ACTIVE)
  buyerPhone   String
  channel      String            @default("WhatsApp")
  aiPersona    NegotiatorPersona @default(BALANCED)
  maxRounds    Int               @default(5)
  currentRound Int               @default(1)
  rounds       OfferRound[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@map("negotiation_sessions")
}

model OfferRound {
  id               String             @id @default(auto()) @map("_id") @db.ObjectId
  sessionId        String
  session          NegotiationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  roundNumber      Int
  sender           SenderType
  offerAmount      Float
  buyerMessage     String?
  aiAction         ActionType?
  aiCounterAmount  Float?
  aiReasoning      String?
  aiBuyerResponse  String?
  isManualOverride Boolean            @default(false)
  createdAt        DateTime           @default(now())

  @@map("offer_rounds")
}