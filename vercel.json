{
  "version": 2,
  "rewrites": [
    { 
      "source": "/(.*)", 
      "destination": "/frontend/index.html" 
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        }
      ]
    }
  ]
}